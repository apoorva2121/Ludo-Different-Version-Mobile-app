# Copy this file to android/keystore.properties and fill in your own values.
# keystore.properties is git-ignored. Never commit it, and never commit the .jks file.
#
# storeFile is resolved relative to the android/ directory, so a keystore kept
# outside the repository needs an absolute path or a relative path that climbs out
# of it. Keeping the key outside the repo is deliberate: it cannot be committed by
# accident.
#
# Create the keystore with:
#   keytool -genkeypair -v -keystore <path>\house-of-kiran-upload.jks \
#           -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# Back the .jks file up somewhere durable and record the passwords in a password
# manager. With Play App Signing an upload key can be reset by Google if lost, but
# recovery is far slower than simply keeping a backup.

storeFile=C:\\Users\\apoor\\OneDrive\\Documents\\HouseOfKiran-signing\\house-of-kiran-upload.jks
storePassword=your-keystore-password
keyAlias=upload
keyPassword=your-key-password
