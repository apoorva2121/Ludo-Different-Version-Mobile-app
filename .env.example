NODE_ENV=development
HOST=127.0.0.1
PORT=8080
AUTH_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
ENABLE_DEV_AUTH=true
GAME_DATABASE_PATH=./data/house-of-kiran.sqlite
ALLOWED_ORIGINS=https://appassets.androidplatform.net
# ALLOW_NULL_ORIGIN=true  # only for a controlled file:// development client
# Production deployment values to add when the database/edge are introduced:
# DATABASE_URL=
# ALLOWED_ORIGINS=
# PUBLIC_API_BASE_URL=https://api.example.com
# PUBLIC_WS_BASE_URL=wss://api.example.com
